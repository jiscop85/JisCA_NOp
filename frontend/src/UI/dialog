import React, {
  useState,
  useEffect,
  useReducer,
  useContext,
  createContext,
  useMemo,
  useCallback,
  memo,
  useRef,
} from 'react';

// ============================================
// 1. Theme Context & Reducer (Advanced State Management)
// ============================================
const ThemeContext = createContext();

const themeReducer = (state, action) => {
  switch (action.type) {
    case 'TOGGLE_THEME':
      return { mode: state.mode === 'light' ? 'dark' : 'light' };
    default:
      return state;
  }
};

const ThemeProvider = ({ children }) => {
  const [state, dispatch] = useReducer(themeReducer, { mode: 'light' });

  // Use localStorage to persist theme preference (custom hook)
  useLocalStorage('theme', state.mode, (storedValue) => {
    if (storedValue && storedValue !== state.mode) {
      dispatch({ type: 'TOGGLE_THEME' }); // simplistic sync
    }
  });

  const value = useMemo(() => ({ theme: state, dispatch }), [state]);

  return (
    <ThemeContext.Provider value={value}>
      {children}
    </ThemeContext.Provider>
  );
};

// ============================================
// 2. Custom Hooks
// ============================================

// Hook for localStorage with effect (syncs changes)
function useLocalStorage(key, initialValue, onLoad) {
  useEffect(() => {
    try {
      const item = window.localStorage.getItem(key);
      if (item && onLoad) {
        onLoad(JSON.parse(item));
      }
    } catch (error) {
      console.log(error);
    }
  }, [key, onLoad]);

  const setValue = (value) => {
    try {
      window.localStorage.setItem(key, JSON.stringify(value));
    } catch (error) {
      console.log(error);
    }
  };

  return [setValue];
}

// Hook for window resize (responsive design)
function useWindowSize() {
  const [size, setSize] = useState({
    width: window.innerWidth,
    height: window.innerHeight,
  });

  useEffect(() => {
    const handleResize = () => {
      setSize({
        width: window.innerWidth,
        height: window.innerHeight,
      });
    };
    window.addEventListener('resize', handleResize);
    return () => window.removeEventListener('resize', handleResize);
  }, []);

  return size;
}

// Mock data fetching hook (simulates API call)
function useFetch(url, initialData = null) {
  const [data, setData] = useState(initialData);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  useEffect(() => {
    let isMounted = true;
    const fetchData = async () => {
      try {
        setLoading(true);
        // Simulate network request
        const response = await new Promise((resolve) =>
          setTimeout(() => resolve({ json: () => ({ message: 'Mock data from ' + url }) }), 1000)
        );
        const result = await response.json();
        if (isMounted) {
          setData(result);
          setError(null);
        }
      } catch (err) {
        if (isMounted) setError(err);
      } finally {
        if (isMounted) setLoading(false);
      }
    };
    fetchData();
    return () => {
      isMounted = false;
    };
  }, [url]);

  return { data, loading, error };
}

// ============================================
// 3. Sub-components (some memoized for performance)
// ============================================

// A reusable Widget container with dynamic styling based on theme
const Widget = memo(({ title, children, ...props }) => {
  const { theme } = useContext(ThemeContext);
  const isDark = theme.mode === 'dark';

  const style = {
    backgroundColor: isDark ? '#333' : '#f9f9f9',
    color: isDark ? '#fff' : '#000',
    padding: '1rem',
    borderRadius: '8px',
    boxShadow: '0 2px 8px rgba(0,0,0,0.1)',
    margin: '1rem',
    flex: '1 1 300px',
    transition: 'all 0.3s ease',
  };

  return (
    <div style={style} {...props}>
      <h3>{title}</h3>
      {children}
    </div>
  );
});

// Chart component (simulated with simple bars)
const Chart = memo(({ data }) => {
  const max = Math.max(...data.map((d) => d.value));
  return (
    <div style={{ display: 'flex', justifyContent: 'space-around', alignItems: 'flex-end', height: '150px' }}>
      {data.map((item, idx) => (
        <div key={idx} style={{ textAlign: 'center', width: '40px' }}>
          <div
            style={{
              height: `${(item.value / max) * 100}px`,
              backgroundColor: '#61dafb',
              width: '30px',
              margin: '0 auto',
              borderRadius: '4px 4px 0 0',
            }}
          />
          <span>{item.label}</span>
        </div>
      ))}
    </div>
  );
});

// Data table component (simple)
const DataTable = memo(({ rows }) => {
  return (
    <table style={{ width: '100%', borderCollapse: 'collapse' }}>
      <thead>
        <tr>
          <th style={{ borderBottom: '1px solid #ccc', padding: '0.5rem' }}>ID</th>
          <th style={{ borderBottom: '1px solid #ccc', padding: '0.5rem' }}>Name</th>
          <th style={{ borderBottom: '1px solid #ccc', padding: '0.5rem' }}>Value</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr key={row.id}>
            <td style={{ padding: '0.5rem', textAlign: 'center' }}>{row.id}</td>
            <td style={{ padding: '0.5rem', textAlign: 'center' }}>{row.name}</td>
            <td style={{ padding: '0.5rem', textAlign: 'center' }}>{row.value}</td>
          </tr>
        ))}
      </tbody>
    </table>
  );
});

// ============================================
// 4. Main Advanced Dashboard Component
// ============================================
const AdvancedDashboard = () => {
  const { theme, dispatch } = useContext(ThemeContext);
  const windowSize = useWindowSize();
  const [filter, setFilter] = useState('');

  // useReducer for local dashboard state (widgets visibility, etc.)
  const [dashboardState, localDispatch] = useReducer(
    (state, action) => {
      switch (action.type) {
        case 'TOGGLE_WIDGET':
          return {
            ...state,
            widgets: state.widgets.map((w) =>
              w.id === action.id ? { ...w, hidden: !w.hidden } : w
            ),
          };
        default:
          return state;
      }
    },
    {
      widgets: [
        { id: 1, title: 'Analytics Chart', hidden: false },
        { id: 2, title: 'Data Overview', hidden: false },
        { id: 3, title: 'Live Feed', hidden: true },
      ],
    }
  );

  // Fetch some data (custom hook)
  const { data: apiData, loading, error } = useFetch('/api/dashboard', null);

  // Memoized chart data to prevent recalculation
  const chartData = useMemo(
    () => [
      { label: 'Jan', value: 40 },
      { label: 'Feb', value: 55 },
      { label: 'Mar', value: 75 },
      { label: 'Apr', value: 20 },
      { label: 'May', value: 90 },
    ],
    []
  );

  // Memoized table data
  const tableData = useMemo(
    () => [
      { id: 1, name: 'Item A', value: 120 },
      { id: 2, name: 'Item B', value: 85 },
      { id: 3, name: 'Item C', value: 200 },
      { id: 4, name: 'Item D', value: 45 },
    ],
    []
  );

  // Callback for toggling theme
  const toggleTheme = useCallback(() => {
    dispatch({ type: 'TOGGLE_THEME' });
  }, [dispatch]);



  // Use ref to focus on filter input after mount
  const inputRef = useRef(null);
  useEffect(() => {
    inputRef.current?.focus();
  }, []);

  // Filtered widgets based on search input
  const filteredWidgets = dashboardState.widgets.filter((w) =>
    w.title.toLowerCase().includes(filter.toLowerCase())
  );

  // Dynamic styles based on theme
  const isDark = theme.mode === 'dark';
  const dashboardStyle = {
    backgroundColor: isDark ? '#222' : '#fff',
    color: isDark ? '#eee' : '#111',
    minHeight: '100vh',
    padding: '2rem',
    transition: 'background-color 0.3s, color 0.3s',
  };

  return (
    <div style={dashboardStyle}>
      {/* Header with theme toggle and responsive info */}
      <header style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '2rem' }}>
        <h1>Advanced Dashboard</h1>
        <div>
          <span style={{ marginRight: '1rem' }}>
            Window: {windowSize.width} x {windowSize.height}
          </span>
          <button
            onClick={toggleTheme}
            style={{
              padding: '0.5rem 1rem',
              backgroundColor: isDark ? '#f0f0f0' : '#333',
              color: isDark ? '#000' : '#fff',
              border: 'none',
              borderRadius: '4px',
              cursor: 'pointer',
            }}
          >
            Switch to {isDark ? 'Light' : 'Dark'} Mode
          </button>
        </div>
      </header>

      {/* Search filter */}
      <div style={{ marginBottom: '1rem' }}>
        <label htmlFor="filter">Filter Widgets: </label>
        <input
          id="filter"
          type="text"
          value={filter}
          onChange={(e) => setFilter(e.target.value)}
          ref={inputRef}
          style={{ padding: '0.5rem', marginLeft: '0.5rem' }}
          placeholder="Type to filter..."
        />
      </div>

      {/* API Data display (loading/error) */}
      <section style={{ marginBottom: '2rem' }}>
        <h2>API Data (custom hook)</h2>
        {loading && <p>Loading...</p>}
        {error && <p style={{ color: 'red' }}>Error: {error.message}</p>}
        {apiData && <pre>{JSON.stringify(apiData, null, 2)}</pre>}
      </section>

      {/* Widgets area - flex wrap for responsiveness */}
      <div style={{ display: 'flex', flexWrap: 'wrap', margin: '-1rem' }}>
        {filteredWidgets.map(
          (widget) =>
            !widget.hidden && (
              <Widget key={widget.id} title={widget.title}>
                {widget.id === 1 && <Chart data={chartData} />}
                {widget.id === 2 && <DataTable rows={tableData} />}
                {widget.id === 3 && (
                  <div>
                    <p>Live updates (simulated)</p>
                    <p>Last updated: {new Date().toLocaleTimeString()}</p>
                  </div>
                )}
                <button
                  onClick={() => localDispatch({ type: 'TOGGLE_WIDGET', id: widget.id })}
                  style={{ marginTop: '1rem', padding: '0.25rem 0.5rem' }}
                >
                  Hide Widget
                </button>
              </Widget>
            )
        )}
      </div>

      {/* Show a message if no widgets match filter */}
      {filteredWidgets.length === 0 && (
        <p style={{ textAlign: 'center', marginTop: '2rem' }}>No widgets match your filter.</p>
      )}
    </div>
  );
};

// ============================================
// 5. Root App Component (wrapped with providers)
// ============================================
const App = () => {
  return (
    <ThemeProvider>
      <AdvancedDashboard />
    </ThemeProvider>
  );
};

export default App;

