import React, {
  useState,
  useEffect,
  useReducer,
  useContext,
  createContext,
  useMemo,
  useCallback,
  memo,
  useRef,
} from 'react';

// ============================================
// 1. Theme Context & Reducer (Advanced State Management)
// ============================================
const ThemeContext = createContext();

const themeReducer = (state, action) => {
  switch (action.type) {
    case 'TOGGLE_THEME':
      return { mode: state.mode === 'light' ? 'dark' : 'light' };
    default:
      return state;
  }
};

const ThemeProvider = ({ children }) => {
  const [state, dispatch] = useReducer(themeReducer, { mode: 'light' });

  // Use localStorage to persist theme preference (custom hook)
  useLocalStorage('theme', state.mode, (storedValue) => {
    if (storedValue && storedValue !== state.mode) {
      dispatch({ type: 'TOGGLE_THEME' }); // simplistic sync
    }
  });

  const value = useMemo(() => ({ theme: state, dispatch }), [state]);

  return (
    <ThemeContext.Provider value={value}>
      {children}
    </ThemeContext.Provider>
  );
};

// ============================================
// 2. Custom Hooks
// ============================================

// Hook for localStorage with effect (syncs changes)
function useLocalStorage(key, initialValue, onLoad) {
  useEffect(() => {
    try {
      const item = window.localStorage.getItem(key);
      if (item && onLoad) {
        onLoad(JSON.parse(item));
      }
    } catch (error) {
      console.log(error);
    }
  }, [key, onLoad]);

  const setValue = (value) => {
    try {
      window.localStorage.setItem(key, JSON.stringify(value));
    } catch (error) {
      console.log(error);
    }
  };

  return [setValue];
}

// Hook for window resize (responsive design)
function useWindowSize() {
  const [size, setSize] = useState({
    width: window.innerWidth,
    height: window.innerHeight,
  });

  useEffect(() => {
    const handleResize = () => {
      setSize({
        width: window.innerWidth,
        height: window.innerHeight,
      });
    };
    window.addEventListener('resize', handleResize);
    return () => window.removeEventListener('resize', handleResize);
  }, []);

  return size;
}

// Mock data fetching hook (simulates API call)
function useFetch(url, initialData = null) {
  const [data, setData] = useState(initialData);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  useEffect(() => {
    let isMounted = true;
    const fetchData = async () => {
      try {
        setLoading(true);
        // Simulate network request
        const response = await new Promise((resolve) =>
          setTimeout(() => resolve({ json: () => ({ message: 'Mock data from ' + url }) }), 1000)
        );
        const result = await response.json();
        if (isMounted) {
          setData(result);
          setError(null);
        }
      } catch (err) {
        if (isMounted) setError(err);
      } finally {
        if (isMounted) setLoading(false);
      }
    };
    fetchData();
    return () => {
      isMounted = false;
    };
  }, [url]);

  return { data, loading, error };
}

