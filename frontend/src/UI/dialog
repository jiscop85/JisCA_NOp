// A reusable Widget container with dynamic styling based on theme
const Widget = memo(({ title, children, ...props }) => {
  const { theme } = useContext(ThemeContext);
  const isDark = theme.mode === 'dark';

  const style = {
    backgroundColor: isDark ? '#333' : '#f9f9f9',
    color: isDark ? '#fff' : '#000',
    padding: '1rem',
    borderRadius: '8px',
    boxShadow: '0 2px 8px rgba(0,0,0,0.1)',
    margin: '1rem',
    flex: '1 1 300px',
    transition: 'all 0.3s ease',
  };

  return (
    <div style={style} {...props}>
      <h3>{title}</h3>
      {children}
    </div>
  );
});

// Chart component (simulated with simple bars)
const Chart = memo(({ data }) => {
  const max = Math.max(...data.map((d) => d.value));
  return (
    <div style={{ display: 'flex', justifyContent: 'space-around', alignItems: 'flex-end', height: '150px' }}>
      {data.map((item, idx) => (
        <div key={idx} style={{ textAlign: 'center', width: '40px' }}>
          <div
            style={{
              height: `${(item.value / max) * 100}px`,
              backgroundColor: '#61dafb',
              width: '30px',
              margin: '0 auto',
              borderRadius: '4px 4px 0 0',
            }}
          />
          <span>{item.label}</span>
        </div>
      ))}
    </div>
  );
});

